{
  "name": "@credentia/snap",
  "version": "0.1.0",
  "description": "Credentia MetaMask Snap: trust insights for outgoing transactions",
  "repository": {
    "type": "git",
    "url": "https://github.com/credentia/credentia.git"
  },
  "license": "MIT",
  "main": "dist/bundle.js",
  "files": [
    "dist/",
    "snap.manifest.json",
    "images/"
  ],
  "scripts": {
    "build": "mm-snap build",
    "serve": "mm-snap serve",
    "watch": "mm-snap watch",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "clean": "rm -rf dist",
    "test:integration": "CREDENTIA_DEMO_MODE=true mm-snap build && jest --config jest.integration.config.js; mm-snap build"
  },
  "dependencies": {
    "@metamask/snaps-sdk": "12.0.1"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@metamask/snaps-cli": "^8.4.1",
    "@metamask/snaps-jest": "^10.2.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.14.10",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.5.3"
  },
  "keywords": [
    "metamask",
    "snap",
    "identity",
    "web3",
    "monad",
    "credentials"
  ],
  "engines": {
    "node": ">=20.0.0"
  }
}
