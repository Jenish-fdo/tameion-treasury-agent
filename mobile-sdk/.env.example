# Example values for your own app. The SDK reads no environment variables itself: pass these to `new CredentiaSDK({...})`.
# Anything bundled into a mobile app can be extracted by users: use a low-privilege, rate-limited key, or none.
CREDENTIA_API_URL=https://your-credentia-api.example
CREDENTIA_API_KEY=
CREDENTIA_CHAIN_ID=10143
CREDENTIA_REGISTRY_ADDRESS=
