# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Credentia

# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_API_VERSION=v1

# Payment Risk Check (server-side only: used by /api/payment-check, never exposed to the browser).
# Must be one of the backend's API_KEYS / PRO_API_KEYS. Do NOT prefix it with NEXT_PUBLIC_.
CREDENTIA_API_URL=http://localhost:3001
CREDENTIA_API_KEY=

# Public settings (safe to expose to browsers; never put secrets in NEXT_PUBLIC_ variables)
NEXT_PUBLIC_MONAD_RPC=https://testnet-rpc.monad.xyz
NEXT_PUBLIC_BACKEND_URL=http://localhost:3001
NEXT_PUBLIC_CREDENTIAL_REGISTRY_ADDRESS=
NEXT_PUBLIC_MONAD_EXPLORER_URL=https://explorer.testnet.monad.xyz

# Blockchain Configuration (legacy name, still read as a fallback)
NEXT_PUBLIC_MONAD_RPC_URL=https://testnet-rpc.monad.xyz
NEXT_PUBLIC_MONAD_CHAIN_ID=10143
NEXT_PUBLIC_MONAD_EXPLORER_URL=https://explorer.testnet.monad.xyz

# Contract Addresses
NEXT_PUBLIC_IDENTITY_REGISTRY_ADDRESS=
NEXT_PUBLIC_ATTESTATION_REGISTRY_ADDRESS=
NEXT_PUBLIC_CREDENTIAL_ISSUER_ADDRESS=

# WalletConnect
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id

# Feature Flags
NEXT_PUBLIC_ENABLE_AI_AGENT_FEATURES=true
NEXT_PUBLIC_ENABLE_ZK_PROOFS=false
NEXT_PUBLIC_ENABLE_ANALYTICS=false

# Analytics (optional)
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_MIXPANEL_TOKEN=

# Environment
NEXT_PUBLIC_ENV=development

# --- Envio HyperIndex ---
# GraphQL endpoint of the indexer in /indexer (http://localhost:8080/v1/graphql for `envio dev`).
# Leave empty and the app reads counts straight from the registry, without history or reputation.
NEXT_PUBLIC_ENVIO_URL=

# --- KIMI Credential Copilot (server only: never prefix with NEXT_PUBLIC_) ---
# Key from https://platform.kimi.ai. Leave empty and the copilot shows as offline.
MOONSHOT_API_KEY=sk-your-moonshot-key
KIMI_MODEL=kimi-k3
MOONSHOT_BASE_URL=https://api.moonshot.ai/v1
