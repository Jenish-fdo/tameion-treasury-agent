# Arc Network (Circle's L1; USDC is the native gas token)
# Testnet: chain ID 5042002. Faucet: https://faucet.circle.com
ARC_TESTNET_RPC=https://rpc.testnet.arc.io
ARC_CHAIN_ID=5042002
ARC_EXPLORER_URL=https://explorer.testnet.arc.io

# Deployment. Prefer a Foundry keystore (--account) over a raw key.
DEPLOYER_PRIVATE_KEY=your_private_key_here
DEPLOYER_ADDRESS=your_address_here

# Optional: address to authorise as an issuer right after deployment
# ISSUER=

# Verification
VERIFY_CONTRACTS=true
