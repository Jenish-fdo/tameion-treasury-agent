# Server
PORT=3001
NODE_ENV=development
LOG_LEVEL=info
CORS_ORIGIN=*
TRUST_PROXY=false

# Authentication - REQUIRED, no default. Comma-separated, each at least 24 chars.
# Generate one with: openssl rand -hex 32
API_KEYS=
PRO_API_KEYS=

# Rate limits (requests per minute, per API key)
RATE_LIMIT_FREE_PER_MIN=100
RATE_LIMIT_PRO_PER_MIN=1000
# POST /intent/evaluate costs three paid model calls, so it has its own hourly limit per key
INTENT_RATE_LIMIT_FREE_PER_HOUR=10
INTENT_RATE_LIMIT_PRO_PER_HOUR=100

# Monad + contracts
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
MONAD_CHAIN_ID=10143
CREDENTIAL_REGISTRY_ADDRESS=
TRUST_SCORE_ADDRESS=
# Comma-separated issuer private keys the API may sign credentials with. Keep these secret.
ISSUER_PRIVATE_KEYS=
# Optional gas payer for issueCredentialWithSig (falls back to the issuer key)
BACKEND_WALLET_PRIVATE_KEY=
TX_CONFIRM_TIMEOUT_MS=8000

# Off-chain credential metadata (credentials.json)
DATA_DIR=./data

# AI consensus models (OpenAI-compatible chat completions API)
# Per-attempt timeout, retries after the first attempt, and base backoff (500ms, then 1s, ...)
MODEL_TIMEOUT_MS=8000
MODEL_MAX_RETRIES=1
MODEL_RETRY_BASE_MS=500

# Kimi / Moonshot. Take the model ID from the Moonshot console/docs; it is never hard-coded.
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.ai/v1
KIMI_MODEL=

# Qwen / Alibaba Model Studio. The base URL depends on your region/account; use the
# OpenAI-compatible URL shown in your Model Studio console (a key only works with its own region's URL).
QWEN_API_KEY=
QWEN_BASE_URL=
QWEN_MODEL=

# Jev / TypeSafe. NOTE: TypeSafe's direct API (api.typesafe.ai /v1/systemone) is NOT OpenAI-compatible.
# This integration only works with an OpenAI-compatible gateway in front of Jev; leave blank to disable Jev
# (Kimi + Qwen can still reach the 2-model quorum).
JEV_API_KEY=
JEV_BASE_URL=
JEV_MODEL=
